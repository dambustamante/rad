# Conexión a Jira para /hdu, que lee y, con confirmación, crea las Tareas de una historia. Copiar a .env y completar. .env nunca se versiona.
JIRA_URL=                # por ejemplo https://empresa.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=              # token de API de Atlassian; crear incidencias permite que /hdu cree las Tareas
CA_BUNDLE=               # opcional: archivo PEM si la red usa una autoridad certificadora propia
