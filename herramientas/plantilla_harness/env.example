# Conexión a Jira para /hdu (lectura) y /tarea (crea la Tarea de una historia). Copiar a .env y completar. .env nunca se versiona.
JIRA_URL=                # por ejemplo https://empresa.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=              # token de API de Atlassian; crear incidencias solo hace falta para /tarea
