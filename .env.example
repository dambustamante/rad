# Conexiones y credenciales de radiografia.
# Copiar a .env y completar. El archivo .env nunca se versiona.
#
# La sincronización de arquitectura y de los repositorios de los productos usa solo git,
# con las credenciales que ya tenga configuradas el equipo (SSH o credential helper).
# Las variables de la plataforma se usan para validar repositorios y, en la fase 2, para
# comentar en MR o PR.

# Plataforma git: gitlab | github
GIT_PLATAFORMA=gitlab

# GitLab (si GIT_PLATAFORMA=gitlab)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=            # permisos: read_api, read_repository

# GitHub (si GIT_PLATAFORMA=github)
GITHUB_URL=https://github.com
GITHUB_TOKEN=            # permisos: lectura de repositorios (contents, metadata)

# SonarCloud
SONAR_URL=https://sonarcloud.io
SONAR_ORGANIZACION=      # clave de la organización en SonarCloud
SONAR_TOKEN=             # token de usuario con permiso de lectura
