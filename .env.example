# Conexiones y credenciales de radiografia.
# Copiar a .env y completar. El archivo .env nunca se versiona.
#
# La sincronización de arquitectura y de los repositorios de los productos usa solo git,
# con las credenciales que ya tenga configuradas el equipo (SSH o credential helper).
# Las variables de la plataforma se usan al revisar ramas (/revisar --rama): buscar el MR o PR, publicar
# el comentario con confirmación y contar MR en el reporte semanal.

# Plataforma git: gitlab | github
GIT_PLATAFORMA=gitlab

# GitLab (si GIT_PLATAFORMA=gitlab)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=            # permiso: api (leer MR y publicar comentarios)
GITLAB_USUARIO=          # opcional: tu usuario, para `mr.py bandeja --mios` (MR donde eres revisor)

# GitHub (si GIT_PLATAFORMA=github)
GITHUB_URL=https://github.com
GITHUB_TOKEN=            # permiso: pull requests (lectura y escritura, para leer y comentar PR)

# Jira Cloud: lee historias de usuario y crea Tareas, Spikes, Errores y Hotfix (solo con --confirmar).
JIRA_URL=                # por ejemplo https://empresa.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=              # token de API de Atlassian

# Confluence (opcional y de solo lectura), para los documentos del producto.
# CONFLUENCE_EMAIL y CONFLUENCE_TOKEN pueden omitirse si son los mismos de Jira.
CONFLUENCE_URL=          # por ejemplo https://empresa.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=

# Sonar: sonarqube (self-hosted, incluida la Community Edition) | sonarcloud
# radiografia solo lee resultados: nunca ejecuta análisis contra el servidor.
SONAR_TIPO=sonarqube
SONAR_URL=               # por ejemplo https://sonar.empresa.com o https://sonarcloud.io
SONAR_ORGANIZACION=      # solo para sonarcloud: clave de la organización
SONAR_TOKEN=             # token de usuario con permiso de lectura (Browse) sobre los proyectos
